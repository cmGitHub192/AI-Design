# Disenia — configuración de Supabase Auth para el login.
#
# 1. Crea un proyecto en https://supabase.com (gratis).
# 2. En el panel del proyecto: Settings → API.
# 3. Copia "Project URL" y la clave "anon public" aquí.
# 4. Guarda este archivo como  apps/web/.env.local  (sin el .example).
# 5. Reinicia el web:  pnpm tools-dev run web --daemon-port 17456 --web-port 17573
#
# NEXT_PUBLIC_* se inyecta en el navegador: la clave "anon" es pública por diseño
# (protégete con Row Level Security en Supabase), NUNCA pongas aquí la "service_role".

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
